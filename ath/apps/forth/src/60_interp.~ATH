// ===========================================================================
// 60_interp : input source, tokenizer, number parsing, and the outer
//             interpreter loop (driven by the batched-recursion trampoline).
//
// The current source line lives both in G_CURLINE (a !~ATH string, for fast
// parsing) and copied into the TIB region of G_MEM (so SOURCE yields a real
// address). >IN and the source length are system variables in G_MEM.
// ===========================================================================

BIRTH G_LINES WITH [];     // all input lines
BIRTH G_LINEIDX WITH -1;   // index of current line (-1 before first refill)
BIRTH G_CURLINE WITH "";   // current line text
BIRTH G_SRC_ADDR WITH 256; // address of current source text (TIB_ADDR default)
BIRTH G_SRC_ID WITH 0;     // SOURCE-ID: 0 = stdin/user, -1 = string (EVALUATE)
BIRTH G_DONE WITH 0;

ENTOMB BATCH WITH 512;

RITE toin() { BEQUEATH fetch(SYSV_TOIN); }
RITE set_toin(v) { store(SYSV_TOIN, v); }
RITE srclen() { BEQUEATH fetch(SYSV_SRCLEN); }
RITE compiling() { BEQUEATH fetch(SYSV_STATE) != 0; }

// Load the next input line into TIB + G_CURLINE. Returns ALIVE on success.
RITE refill() {
    G_LINEIDX = G_LINEIDX + 1;
    SHOULD G_LINEIDX >= LENGTH(G_LINES) { BEQUEATH DEAD; }
    BIRTH line WITH G_LINES[G_LINEIDX];
    G_CURLINE = line;
    G_SRC_ADDR = TIB_ADDR;
    str_to_mem(TIB_ADDR, line);
    store(SYSV_SRCLEN, LENGTH(line));
    set_toin(0);
    BEQUEATH ALIVE;
}

RITE is_space(code) {
    BEQUEATH code == 32 OR code == 9 OR code == 13 OR code == 10;
}

// Parse the next blank-delimited token from the current line, advancing >IN.
// Returns "" at end of line.
RITE parse_name() {
    BIRTH len WITH srclen();
    BIRTH i WITH skip_spaces(toin(), len);
    BIRTH start WITH i;
    BIRTH e WITH scan_word(i, len);
    // Consume the single trailing delimiter, like a standard text interpreter,
    // so words that PARSE immediately (WORD, S", CHAR ...) see content directly.
    SHOULD e < len { set_toin(e + 1); } LEST { set_toin(len); }
    BEQUEATH SUBSTRING(G_CURLINE, start, e);
}
RITE skip_spaces(i, len) {
    SHOULD i >= len { BEQUEATH i; }
    SHOULD is_space(CODE(G_CURLINE[i])) { BEQUEATH skip_spaces(i + 1, len); }
    BEQUEATH i;
}
RITE scan_word(i, len) {
    SHOULD i >= len { BEQUEATH i; }
    SHOULD is_space(CODE(G_CURLINE[i])) { BEQUEATH i; }
    BEQUEATH scan_word(i + 1, len);
}

// Parse text up to (and consuming) the delimiter character `delim`.
// Returns the text between >IN and the delimiter; advances >IN past delim.
RITE parse_until(delim) {
    BIRTH len WITH srclen();
    BIRTH start WITH toin();
    BIRTH e WITH scan_until(start, len, delim);
    BIRTH text WITH SUBSTRING(G_CURLINE, start, e);
    SHOULD e < len { set_toin(e + 1); } LEST { set_toin(len); }
    BEQUEATH text;
}
RITE scan_until(i, len, delim) {
    SHOULD i >= len { BEQUEATH i; }
    SHOULD CODE(G_CURLINE[i]) == delim { BEQUEATH i; }
    BEQUEATH scan_until(i + 1, len, delim);
}

// RESTORE-INPUT: pop `n` saved cells; return the last (deepest) one, which is
// the >IN value SAVE-INPUT pushed first.
RITE restore_input_consume(n, last) {
    SHOULD n <= 0 { BEQUEATH last; }
    BIRTH v WITH pop();
    BEQUEATH restore_input_consume(n - 1, v);
}

// --- S\" escaped-string parsing (Forth 2012) --------------------------------
// Scan G_CURLINE from >IN to the first unescaped '"', decoding escape sequences
// into an array of byte codes; advance >IN past the closing quote. Returns the
// array of codes (bytes may be 0/NUL, so a code array -- not a string).
RITE parse_escaped_string() {
    BIRTH r WITH esc_scan(toin(), srclen(), []);
    set_toin(r.next);
    BEQUEATH r.codes;
}
RITE esc_scan(i, len, acc) {
    SHOULD i >= len { BEQUEATH {codes: acc, next: len}; }
    BIRTH c WITH CODE(G_CURLINE[i]);
    SHOULD c == 34 { BEQUEATH {codes: acc, next: i + 1}; }    // closing quote
    SHOULD c == 92 { BEQUEATH esc_escape(i + 1, len, acc); } // backslash
    BEQUEATH esc_scan(i + 1, len, APPEND(acc, c));
}
RITE esc_escape(i, len, acc) {
    SHOULD i >= len { BEQUEATH {codes: acc, next: len}; }    // trailing backslash
    BIRTH ec WITH G_CURLINE[i];
    BIRTH lc WITH LOWERCASE(ec);
    SHOULD lc == "x" { BEQUEATH esc_hex(i + 1, len, acc); }
    SHOULD lc == "m" {                                        // CR/LF pair
        BEQUEATH esc_scan(i + 1, len, APPEND(APPEND(acc, 13), 10));
    }
    BEQUEATH esc_scan(i + 1, len, APPEND(acc, esc_map(lc, ec)));
}
RITE esc_map(lc, ec) {
    SHOULD lc == "a" { BEQUEATH 7; }
    SHOULD lc == "b" { BEQUEATH 8; }
    SHOULD lc == "e" { BEQUEATH 27; }
    SHOULD lc == "f" { BEQUEATH 12; }
    SHOULD lc == "l" { BEQUEATH 10; }
    SHOULD lc == "n" { BEQUEATH 10; }     // newline (system-dependent value)
    SHOULD lc == "q" { BEQUEATH 34; }
    SHOULD lc == "r" { BEQUEATH 13; }
    SHOULD lc == "t" { BEQUEATH 9; }
    SHOULD lc == "v" { BEQUEATH 11; }
    SHOULD lc == "z" { BEQUEATH 0; }
    SHOULD ec == "\"" { BEQUEATH 34; }
    SHOULD ec == "\\" { BEQUEATH 92; }
    BEQUEATH CODE(ec);                     // unknown escape: the char itself
}
// \xHH : up to two hex digits, case-insensitive.
RITE esc_hex(i, len, acc) {
    BIRTH d1 WITH hex_digit_at(i, len);
    SHOULD d1 < 0 { BEQUEATH esc_scan(i, len, APPEND(acc, 0)); }
    BIRTH d2 WITH hex_digit_at(i + 1, len);
    SHOULD d2 < 0 { BEQUEATH esc_scan(i + 1, len, APPEND(acc, d1)); }
    BEQUEATH esc_scan(i + 2, len, APPEND(acc, d1 * 16 + d2));
}
RITE hex_digit_at(i, len) {
    SHOULD i >= len { BEQUEATH -1; }
    BIRTH d WITH CODE(UPPERCASE(G_CURLINE[i]));
    SHOULD d >= 48 AND d <= 57 { BEQUEATH d - 48; }
    SHOULD d >= 65 AND d <= 70 { BEQUEATH d - 55; }
    BEQUEATH -1;
}
// Write an array of byte codes into memory at addr.
RITE codes_to_mem(addr, codes, i) {
    SHOULD i >= LENGTH(codes) { BEQUEATH VOID; }
    c_store(addr + i, codes[i]);
    BEQUEATH codes_to_mem(addr, codes, i + 1);
}

// --- number parsing ---------------------------------------------------------
RITE digit_val(c) {
    BIRTH d WITH CODE(UPPERCASE(c));
    SHOULD d >= 48 AND d <= 57 { BEQUEATH d - 48; }
    SHOULD d >= 65 AND d <= 90 { BEQUEATH d - 55; }
    BEQUEATH -1;
}
// Returns {ok: BOOLEAN, val: INTEGER}.
RITE parse_number(tok) {
    BIRTH n WITH LENGTH(tok);
    SHOULD n == 0 { BEQUEATH {ok: DEAD, val: 0}; }
    BIRTH neg WITH 0;
    BIRTH start WITH 0;
    SHOULD tok[0] == "-" {
        SHOULD n == 1 { BEQUEATH {ok: DEAD, val: 0}; }
        neg = 1; start = 1;
    }
    BIRTH base WITH cur_base();
    BEQUEATH parse_digits(tok, start, n, base, neg, 0);
}
RITE parse_digits(tok, i, n, base, neg, acc) {
    SHOULD i >= n {
        SHOULD neg == 1 { BEQUEATH {ok: ALIVE, val: s32(0 - acc)}; }
        BEQUEATH {ok: ALIVE, val: s32(acc)};
    }
    BIRTH d WITH digit_val(tok[i]);
    SHOULD d < 0 OR d >= base { BEQUEATH {ok: DEAD, val: 0}; }
    BEQUEATH parse_digits(tok, i + 1, n, base, neg, acc * base + d);
}

// --- interpret one token ----------------------------------------------------
RITE interpret_word(tok) {
    BIRTH xt WITH find(tok);
    SHOULD xt != 0 {
        SHOULD compiling() AND NOT is_immediate(xt) {
            compile_xt(xt);
        } LEST {
            execute_xt(xt);
        }
        BEQUEATH VOID;
    }
    BIRTH num WITH parse_number(tok);
    SHOULD num.ok {
        SHOULD compiling() { compile_literal(num.val); } LEST { push(num.val); }
        BEQUEATH VOID;
    }
    CONDEMN tok + " ?";
}

// One interpreter step: parse + handle a token, refilling at end of line.
RITE step_interp() {
    BIRTH tok WITH parse_name();
    SHOULD tok == "" {
        SHOULD NOT refill() { G_DONE = 1; }
        BEQUEATH VOID;
    }
    interpret_word(tok);
}

// Reset interpreter/VM state after an uncaught error and abandon the line.
RITE reset_after_error(err) {
    emit_str("\n" + err + "\n");
    clear_stacks();
    G_VM_CODE = VOID;
    G_CALLS = [];
    G_CCODE = [];
    G_CURRENT_XT = -1;
    store(SYSV_STATE, 0);
    set_toin(srclen());
}

// One scheduler step: advance the VM if running, else interpret a token.
RITE scheduler_step() {
    ATTEMPT {
        SHOULD vm_active() { vm_step(); } LEST { step_interp(); }
    } SALVAGE err {
        reset_after_error(err);
    }
}

// --- the trampoline driver --------------------------------------------------
RITE run_batch(k) {
    SHOULD k <= 0 { BEQUEATH VOID; }
    SHOULD G_DONE == 1 { BEQUEATH VOID; }
    scheduler_step();
    BEQUEATH run_batch(k - 1);
}
RITE driver() {
    SHOULD G_DONE == 1 {
        flush_all();
        THIS.DIE();
        BEQUEATH VOID;
    }
    run_batch(BATCH);
    import timer T(1);
    ~ATH(T) {
    } EXECUTE(driver());
}
