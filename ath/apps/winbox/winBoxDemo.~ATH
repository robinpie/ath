// winBoxDemo.~ATH -- opens a Windows MessageBox via the C FFI.
//
// This demo shows !~ATH calling straight into user32.dll through the
// Foreign Session mechanism -- no C wrapper.  The session loads user32
// and invokes MessageBoxA directly:
//
//     int MessageBoxA(HWND hWnd, LPCSTR text, LPCSTR caption, UINT type);
//
// The catch is HWND: it is pointer-sized (8 bytes on win64), but !~ATH's
// FFI INTEGER maps to C `long`, which is only 32 bits on win64 (LLP64).
// We need a pointer-sized NULL, and a plain INTEGER cannot carry one.
//
// !^CAKE supplies it.  winbox.^CAKE declares a one-field recipe whose
// ingredient is a RELIC (a void*).  BAKE zeroes it; SCOOP reads the
// pointer field back as a loose RELIC holding NULL -- the NULL HWND that
// MessageBoxA expects, with no shim DLL in between.  (Earlier this demo
// needed winbox_wrapper.dll purely to inject that NULL from the C side.)
//
// ── Build instructions for cross-compiling from Linux ─────────────────────
//
//   1. Transpile this file to C89:
//      wine ath/transpiler-to-c/athtoc-bin-win64.exe \
//          < ath/apps/winbox/winBoxDemo.~ATH > /tmp/winBoxDemo.c
//
//   2. Compile the C89 output:
//      x86_64-w64-mingw32-gcc -std=c89 -O2 /tmp/winBoxDemo.c \
//          ath/transpiler-to-c/runtime/*.c \
//          -Iath/transpiler-to-c/runtime \
//          -Iath/transpiler-to-c/vendor/win64/libffi/include \
//          -Wl,-Bstatic ath/transpiler-to-c/vendor/win64/libffi/lib/libffi.a \
//          -Wl,-Bdynamic -lws2_32 -static-libgcc \
//          -o /tmp/winBoxDemo.exe
//
//   3. Run under Wine (winbox.^CAKE must sit alongside the exe so the
//      watcher import can find it):
//      cp ath/apps/winbox/winbox.^CAKE /tmp/
//      wine /tmp/winBoxDemo.exe
//
// ── Button flag constants (MB_* from winuser.h) ───────────────────────────
//   0   = MB_OK
//   1   = MB_OKCANCEL
//   4   = MB_YESNO
//   MB_ICONINFORMATION = 0x40  (64)
// ── Return value ──────────────────────────────────────────────────────────
//   IDOK=1  IDCANCEL=2  IDYES=6  IDNO=7

// MB_OK | MB_ICONINFORMATION
ENTOMB MB_OK_INFO WITH 64;

// A NULL HWND, manufactured from a zeroed RELIC ingredient.
import watcher Schema("winbox.^CAKE");
BIRTH nullHwnd WITH SCOOP(BAKE(Schema.Hwnd), Schema.Hwnd, "null");

import session Lib("user32.dll") {
    TRANSCRIBE MessageBoxA(RELIC, STRING, STRING, INTEGER) -> INTEGER;
}

BIRTH result WITH Lib.MessageBoxA(
    nullHwnd,
    "Hello from !~ATH running on Windows!\n\nThe foreign session called MessageBoxA in user32.dll directly -- no wrapper.",
    "!~ATH Windows Demo",
    MB_OK_INFO
);

UTTER("MessageBox returned:", result);

SHOULD result == 1 {
    UTTER("User clicked OK");
}

Lib.DIE();
THIS.DIE();
