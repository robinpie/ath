// A wait-mode ~ATH body may hold nested ~ATH loops (and nothing else). They run
// once the awaited entity dies, ahead of the EXECUTE clause, which in turn runs
// ahead of whatever follows the loop.

UTTER("start");

import timer T1(20ms);
import timer T2(60ms);

~ATH(T1) {
    ~ATH(T2) {
    } EXECUTE(UTTER("body inner"));
} EXECUTE(UTTER("outer execute"));

UTTER("after loop");

// Again, with the body's loop chaining a further wait out of its own EXECUTE:
// the whole body subtree must resolve before the outer EXECUTE clause.
import timer T3(20ms);
import timer T4(40ms);

~ATH(T3) {
    ~ATH(T4) {
    } EXECUTE(
        UTTER("second body inner");
        import timer T5(20ms);
        ~ATH(T5) {
        } EXECUTE(UTTER("second body inner deeper"));
    );
} EXECUTE(UTTER("second outer execute"));

UTTER("second after loop");

THIS.DIE();
