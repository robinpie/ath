import watcher M("./cake_alchemy_mods.^CAKE");
// A marble cake holds its arms as whole recipes, so each arm keeps its own
// DENSE (payload right after the 1-byte tag, not at 4) and IMPERIAL.
UTTER(SIZEOF(M.Marble));
BIRTH m WITH BAKE(M.Marble);
SPRINKLE(m, M.Marble, "FLAVOR", 1);
SPRINKLE(m, M.Marble, "ArmB.b", 305419896);
// byte 0 is the tag; bytes 1..4 are ArmB.b, most-significant byte first.
UTTER(BYTE_AT(m, 0), BYTE_AT(m, 1), BYTE_AT(m, 2), BYTE_AT(m, 3), BYTE_AT(m, 4));
UTTER(SCOOP(m, M.Marble, "ArmB.b"));
THIS.DIE();
