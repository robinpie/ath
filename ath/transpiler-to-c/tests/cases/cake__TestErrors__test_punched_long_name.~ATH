// Regression: the STALE message was sprintf-ed into a 160-byte stack buffer,
// so a long recipe name overflowed the stack.
ATTEMPT {
    import watcher P("./cake_punch_longname.^CAKE");
    UTTER("unreachable");
} SALVAGE err {
    UTTER(err);
}
THIS.DIE();
