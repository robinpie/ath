// Layout sizes are capped at 1 GiB so size/offset arithmetic can never wrap
// (a wrapped size made BAKE under-allocate and SPRINKLE write out of bounds).
import watcher Ok("./cake_huge_ok.^CAKE");
UTTER("at the limit:", SIZEOF(Ok.Big));
ATTEMPT { import watcher A("./cake_huge_count.^CAKE"); UTTER("unreachable"); } SALVAGE e { UTTER("count:", e); }
ATTEMPT { import watcher B("./cake_huge_product.^CAKE"); UTTER("unreachable"); } SALVAGE e { UTTER("product:", e); }
ATTEMPT { import watcher C("./cake_huge_literal.^CAKE"); UTTER("unreachable"); } SALVAGE e { UTTER("literal:", e); }
ATTEMPT { import watcher D("./cake_huge_struct.^CAKE"); UTTER("unreachable"); } SALVAGE e { UTTER("struct:", e); }
// a 64-bit literal saturates to a non-power-of-two on 32-bit long, so only report that it was rejected
ATTEMPT { import watcher E("./cake_huge_rise.^CAKE"); UTTER("unreachable"); } SALVAGE e { UTTER("rise: rejected"); }
THIS.DIE();
