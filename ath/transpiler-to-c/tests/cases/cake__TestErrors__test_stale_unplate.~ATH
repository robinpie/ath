import watcher M("./cake_schema.^CAKE");
BIRTH p WITH BAKE(M.Point);
BIRTH framed WITH PLATE(p, M.Point);
ATTEMPT {
    BIRTH bad WITH UNPLATE(framed, M.Segment);
    UTTER("unreachable");
} SALVAGE err {
    UTTER("caught STALE");
}
THIS.DIE();
