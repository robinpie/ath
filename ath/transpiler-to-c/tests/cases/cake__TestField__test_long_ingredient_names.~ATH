// Regression: path segments were copied into a 128-byte buffer and silently
// truncated, so a name longer than 127 bytes was unreachable, or resolved to a
// different field sharing the truncated prefix (found by fuzz/fuzz_cake.c).
import watcher L("./cake_longnames.^CAKE");
BIRTH short WITH "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
BIRTH long WITH short + "b";
BIRTH buf WITH BAKE(L.Long);
SPRINKLE(buf, L.Long, long, 7);
UTTER("short:", SCOOP(buf, L.Long, short));
UTTER("long:", SCOOP(buf, L.Long, long));
THIS.DIE();
