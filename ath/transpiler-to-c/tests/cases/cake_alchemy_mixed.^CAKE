// A packed cake merged into an unpacked one: the operands disagree on DENSE,
// so the merge is CURDLED at load time.
DENSE RECIPE Packed { INGREDIENT a: PINCH; }
RECIPE Loose { INGREDIENT b: SPOON; }
RECIPE Mixed = Packed && Loose;
