// The alchemy declaration form has no modifier slot -- an alchemized recipe
// inherits DENSE / IMPERIAL from its operands -- so this is a parse error.
RECIPE A { INGREDIENT a: PINCH; }
RECIPE B { INGREDIENT b: SPOON; }
DENSE RECIPE Bad = A && B;
