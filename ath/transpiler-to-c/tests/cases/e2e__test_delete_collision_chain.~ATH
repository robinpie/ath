// Regression: deleting a key at its home slot must not sever the linear-probe
// chain for a later key that collided into the same bucket. "k0" and "k8" hash
// to the same bucket (mod 8); deleting "k0" must keep "k8" reachable.
BIRTH m WITH {};
m = SET(m, "k0", 1);
m = SET(m, "k8", 2);
m = DELETE(m, "k0");
UTTER(HAS(m, "k8"));
UTTER(m["k8"]);
UTTER(HAS(m, "k0"));
THIS.DIE();
