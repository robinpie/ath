// A RITE defined inside another RITE must be emitted as its own C function
// and may close over the enclosing rite's locals.
RITE outer(x) {
    BIRTH bump WITH 100;
    RITE inner(y) {
        BEQUEATH y * 2 + bump;
    }
    RITE twice(z) {
        BEQUEATH inner(z) + inner(z);
    }
    BEQUEATH twice(x);
}

UTTER(outer(5));
THIS.DIE();
