// A runtime error that interpolates a user-controlled string must be bounded:
// the message is truncated to the runtime's fixed buffer, never written past it.
BIRTH p WITH "zzzzzzzzzz";
p = p + p;   // 20
p = p + p;   // 40
p = p + p;   // 80
p = p + p;   // 160
p = p + p;   // 320
p = p + p;   // 640
p = p + p;   // 1280
p = p + p;   // 2560
UTTER(LENGTH(p));

// The reported repro: SCRY's "cannot open file '%s'" interpolates the path.
ATTEMPT {
    BIRTH x WITH SCRY(p);
    UTTER("unreachable", x);
} SALVAGE err {
    UTTER(LENGTH(err));
    UTTER(SUBSTRING(err, 0, 30));
    UTTER(SUBSTRING(err, 508, 511));
}

// The same bound, with no filesystem involved at all.
ATTEMPT {
    BIRTH y WITH PARSE_INT(p);
    UTTER("unreachable", y);
} SALVAGE err2 {
    UTTER(LENGTH(err2));
    UTTER(SUBSTRING(err2, 0, 30));
    UTTER(SUBSTRING(err2, 508, 511));
}

THIS.DIE();
