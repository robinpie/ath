// Spec: BANISH on a relic runs its destructor and curses it. Further use is
// a catchable runtime error.
import session L("libc.so.6") {
    TRANSCRIBE fopen(STRING, STRING) -> RELIC DROPS fclose;
    TRANSCRIBE fclose(RELIC) -> INTEGER;
    TRANSCRIBE fputs(STRING, RELIC) -> INTEGER;
}
BIRTH f WITH L.fopen("/tmp/_ath_test_banish.txt", "w");
L.fputs("hi\n", f);
BANISH f;
ATTEMPT {
    L.fputs("nope", f);
    UTTER("unexpectedly succeeded");
} SALVAGE err {
    UTTER("caught");
}
THIS.DIE();
