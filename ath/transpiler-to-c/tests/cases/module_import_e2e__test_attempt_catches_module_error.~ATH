// A module that errors during init, imported inside ATTEMPT: the error
// must land in SALVAGE and execution must continue after the ATTEMPT.
UTTER("before");
ATTEMPT {
    import watcher M("module_import_e2e__test_attempt_catches_module_error.mod0.~ATH");
    UTTER("not reached");
} SALVAGE e {
    UTTER("caught:", e);
}
UTTER("after");
THIS.DIE();
