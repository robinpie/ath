// A successful module import inside ATTEMPT: exports must be usable in the
// rest of the attempt body, and a later CONDEMN in the body must still be
// caught by the same SALVAGE.
ATTEMPT {
    import watcher M("module_import_e2e__test_attempt_import_success.mod0.~ATH");
    UTTER("ok:", M.double(21), M.version);
    CONDEMN "post-import boom";
} SALVAGE e {
    UTTER("caught:", e);
}
UTTER("after");
THIS.DIE();
