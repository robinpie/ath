// CODE on a byte-truncated or malformed UTF-8 sequence returns the raw lead
// byte instead of reading past the end of the string.
BIRTH smile WITH "☺";               // E2 98 BA
UTTER(CODE(smile));                 // 9786
UTTER(CODE(SUBSTRING(smile, 0, 1))); // lone lead byte -> 226
UTTER(CODE(SUBSTRING(smile, 0, 2))); // truncated 3-byte sequence -> 226
UTTER(CODE(SUBSTRING(smile, 1, 3))); // stray continuation byte -> 152
UTTER(CODE("é"));                   // 233
THIS.DIE();
