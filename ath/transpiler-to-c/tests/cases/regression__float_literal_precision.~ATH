// Float literals were emitted into the generated C via STRING(v), which keeps
// only 6 significant digits: 3.14159265358979 compiled as 3.14159, and a
// literal past DBL_MAX came out as the (non-C) token "inf". Found by AFL++.
BIRTH pi WITH 3.14159265358979;
UTTER(pi == PARSE_FLOAT("3.14159265358979"));
UTTER(INT(pi * 100000000.0));
BIRTH e WITH 2.718281828459045;
UTTER(INT(e * 100000000.0));
UTTER(0.1234567891 == PARSE_FLOAT("0.1234567891"));
UTTER(-0.000001234567 == PARSE_FLOAT("-0.000001234567"));
BIRTH huge WITH .5;
UTTER(huge == PARSE_FLOAT("1e400"));
THIS.DIE();
