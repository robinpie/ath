// Integer operators wrap (two's complement) and shift counts are taken modulo
// the integer width, with no C undefined behaviour. Written width-independently:
// 1 << 63 is LONG_MIN for both 64-bit and 32-bit long once the count is masked.
BIRTH m WITH 1 << 63;
UTTER(m < 0);
UTTER(m / -1 == m);      // LONG_MIN / -1 used to trap with SIGFPE
UTTER(m % -1);
UTTER(-m == m);
UTTER(m - 1 > 0);
UTTER((m - 1) + 1 == m);
UTTER(m * 2);
UTTER(1 << 64);          // count masked to the width -> 1 << 0
UTTER((1 << -1) == m);   // negative count masked too
UTTER(-1 << 3);
UTTER(-8 >> 1 > 0);      // >> is a logical shift
UTTER(7 / -1, 7 % -1);
THIS.DIE();
