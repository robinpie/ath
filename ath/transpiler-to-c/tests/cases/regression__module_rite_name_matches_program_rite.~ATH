// A module rite and a program rite with the same name both compiled to
// _rite_<name>, a C redefinition. Module rites now get a per-module C prefix.
import watcher Lib("regression__module_rite_name_matches_program_rite.mod0.~ATH");
RITE helper(x) { BEQUEATH x + 1; }
UTTER(helper(1), Lib.helper(1), Lib.twice(1));
THIS.DIE();
