// Regression: a plain (non-module) watcher entity must die when its
// watched file is deleted out from under it.
INSCRIBE("../work/watcher_delete_target.txt", "x");
import watcher W("../work/watcher_delete_target.txt");
import process P("sh", "-c", "sleep 0.3 && rm -f ../work/watcher_delete_target.txt");

~ATH(W) {
} EXECUTE(UTTER("watcher fired"));

THIS.DIE();
