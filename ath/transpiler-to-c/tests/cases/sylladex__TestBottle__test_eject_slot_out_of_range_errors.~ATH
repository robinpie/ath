// Spec: EJECT SLOT n FROM a bottle with n out of range is a runtime error.
ATTEMPT {
    BIRTH B WITH BOTTLE(3);
    BIRTH v WITH EJECT SLOT 3 FROM B;
    UTTER("no error");
} SALVAGE err { UTTER("caught"); }
THIS.DIE();
