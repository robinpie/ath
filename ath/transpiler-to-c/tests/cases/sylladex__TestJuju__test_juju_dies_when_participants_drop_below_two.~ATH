// Spec: a JUJU dies once fewer than two of its participants remain alive.
// ALICE and BOB both participate then die; OBSERVER outlives them and
// finds the JUJU dead on a later operation.
BIRTH J WITH JUJU(2);

bifurcate THIS[AB, OBSERVER];
bifurcate AB[ALICE, BOB];

~ATH(ALICE) {
    CAPTCHALOGUE "hi" INTO J SLOT 0;
} EXECUTE(VOID);

~ATH(BOB) {
    import timer TB(5ms);
    ~ATH(TB) {
    } EXECUTE(
        BIRTH msg WITH EJECT SLOT 0 FROM J;
        UTTER(msg);
    );
} EXECUTE(VOID);

~ATH(OBSERVER) {
    import timer TO(20ms);
    ~ATH(TO) {
    } EXECUTE(
        ATTEMPT {
            CAPTCHALOGUE "late" INTO J SLOT 1;
            UTTER("no error");
        } SALVAGE err {
            UTTER("caught");
        }
    );
} EXECUTE(VOID);

[[ALICE, BOB], OBSERVER].DIE();
