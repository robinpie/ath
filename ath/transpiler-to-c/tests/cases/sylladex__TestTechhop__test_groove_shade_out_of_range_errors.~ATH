// Spec: EJECT GROOVE g SHADE s FROM a techhop with g or s out of range
// is a runtime error.
RITE alwaysTrue(v, i) { BEQUEATH ALIVE; }
ATTEMPT {
    BIRTH TH WITH TECHHOP(2, 2, alwaysTrue, alwaysTrue);
    BIRTH v WITH EJECT GROOVE 2 SHADE 0 FROM TH;
    UTTER("no error");
} SALVAGE err { UTTER("caught"); }
THIS.DIE();
