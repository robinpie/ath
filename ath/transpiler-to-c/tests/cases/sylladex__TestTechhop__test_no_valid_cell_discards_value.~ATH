// Spec: if no cell qualifies for a value (or all qualifying cells are
// occupied), CAPTCHALOGUE silently discards it -- no growth, no error.
RITE neverMatches(v, i) { BEQUEATH DEAD; }
BIRTH TH WITH TECHHOP(2, 2, neverMatches, neverMatches);
CAPTCHALOGUE "orphan" INTO TH;
UTTER(STRING(TH));
UTTER(COUNT(TH));
THIS.DIE();
