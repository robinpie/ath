RITE alwaysTrue(v, i) { BEQUEATH ALIVE; }
ATTEMPT {
    BIRTH TH WITH TECHHOP(0, 2, alwaysTrue, alwaysTrue);
    UTTER("no error");
} SALVAGE err { UTTER("caught"); }
