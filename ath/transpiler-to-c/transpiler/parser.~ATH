// parser.~ATH -- recursive descent parser for !~ATH
// parse(toks) -> AST root {t:"Program",stmts:[...]}
// AST nodes: {t:TYPE, ...fields...}
// Statement types: Import Bifurcate AthLoop Die VarDecl ConstDecl Assign RiteDef Cond AttemptSalvage Condemn Bequeath ExprStmt
// Expression types: Lit Ident BinOp UnaryOp Call Index Member Array Map

// --- Helpers ---

RITE cur(toks, pos) { BEQUEATH toks[pos]; }
RITE curT(toks, pos) { BEQUEATH toks[pos].t; }

RITE expect(toks, pos, ty) {
    SHOULD toks[pos].t != ty {
        CONDEMN "Parse error at line " + STRING(toks[pos].l) + ": expected " + ty + " got " + toks[pos].t;
    }
    BEQUEATH pos + 1;
}

RITE matchTok(toks, pos, ty) {
    SHOULD toks[pos].t == ty { BEQUEATH {matched: ALIVE, pos: pos+1}; }
    BEQUEATH {matched: DEAD, pos: pos};
}

// --- Top level ---

RITE parse(toks) {
    BEQUEATH parseStmts(toks, 0, []);
}

RITE parseStmts(toks, pos, stmts) {
    SHOULD toks[pos].t == "EOF" {
        BEQUEATH {t: "Program", stmts: stmts};
    }
    BIRTH r WITH parseStmt(toks, pos);
    BEQUEATH parseStmts(toks, r.pos, APPEND(stmts, r.node));
}

RITE parseStmt(toks, pos) {
    BIRTH ty WITH toks[pos].t;
    SHOULD ty == "import" { BEQUEATH parseImport(toks, pos); }
    SHOULD ty == "bifurcate" { BEQUEATH parseBifurcate(toks, pos); }
    SHOULD ty == "~ATH" { BEQUEATH parseAthLoop(toks, pos); }
    SHOULD ty == "BIRTH" { BEQUEATH parseVarDecl(toks, pos); }
    SHOULD ty == "ENTOMB" { BEQUEATH parseConstDecl(toks, pos); }
    SHOULD ty == "RITE" { BEQUEATH parseRiteDef(toks, pos); }
    SHOULD ty == "SHOULD" { BEQUEATH parseCond(toks, pos); }
    SHOULD ty == "ATTEMPT" { BEQUEATH parseAttemptSalvage(toks, pos); }
    SHOULD ty == "CONDEMN" { BEQUEATH parseCondemnStmt(toks, pos); }
    SHOULD ty == "BEQUEATH" { BEQUEATH parseBequeathStmt(toks, pos); }
    SHOULD ty == "CAPTCHALOGUE" { BEQUEATH parseCaptchalogue(toks, pos); }
    SHOULD ty == "BANISH" { BEQUEATH parseBanish(toks, pos); }
    SHOULD ty == "ID" OR ty == "THIS" OR ty == "[" { BEQUEATH parseDieOrAssignOrExpr(toks, pos); }
    CONDEMN "Unexpected token: " + ty + " at line " + STRING(toks[pos].l);
}

// Same as parseStmt but for inside EXECUTE/RITE bodies
RITE parseExprStmt(toks, pos) {
    BIRTH ty WITH toks[pos].t;
    SHOULD ty == "import" { BEQUEATH parseImport(toks, pos); }
    SHOULD ty == "~ATH" { BEQUEATH parseAthLoop(toks, pos); }
    SHOULD ty == "BIRTH" { BEQUEATH parseVarDecl(toks, pos); }
    SHOULD ty == "ENTOMB" { BEQUEATH parseConstDecl(toks, pos); }
    SHOULD ty == "RITE" { BEQUEATH parseRiteDef(toks, pos); }
    SHOULD ty == "SHOULD" { BEQUEATH parseCond(toks, pos); }
    SHOULD ty == "ATTEMPT" { BEQUEATH parseAttemptSalvage(toks, pos); }
    SHOULD ty == "CONDEMN" { BEQUEATH parseCondemnStmt(toks, pos); }
    SHOULD ty == "BEQUEATH" { BEQUEATH parseBequeathStmt(toks, pos); }
    SHOULD ty == "CAPTCHALOGUE" { BEQUEATH parseCaptchalogue(toks, pos); }
    SHOULD ty == "BANISH" { BEQUEATH parseBanish(toks, pos); }
    SHOULD ty == "VOID" {
        BIRTH p WITH pos + 1;
        BIRTH mr WITH matchTok(toks, p, ";");
        SHOULD mr.matched { p = mr.pos; }
        BEQUEATH {node: {t:"ExprStmt",expr:{t:"Lit",vt:"VOID",v:VOID},l:toks[pos].l}, pos: p};
    }
    // Expression (may be assignment)
    BIRTH re WITH parseExpr(toks, pos);
    BIRTH expr WITH re.node;
    BIRTH p WITH re.pos;
    // Check for assignment
    SHOULD toks[p].t == "=" {
        p = p + 1;
        BIRTH rv WITH parseExpr(toks, p);
        SHOULD toks[rv.pos].t == ";" { p = rv.pos + 1; } LEST { p = rv.pos; }
        BEQUEATH {node:{t:"Assign",target:expr,val:rv.node,l:expr.l}, pos: p};
    }
    // x.DIE() -- convert to a Die statement instead of a regular call, matching the top-level parseStmt behaviour. Without this, inside an EXECUTE clause `Lc.DIE()` would degenerate into ath_call_sync on the session's "DIE" rite (which doesn't exist) and CONDEMN.
    SHOULD expr.t == "Call" AND HAS(expr, "callee") AND expr.callee.t == "Member" AND expr.callee.mem == "DIE" {
        BIRTH obj WITH expr.callee.obj;
        BIRTH nm WITH obj.name;
        BIRTH mr WITH matchTok(toks, p, ";");
        BEQUEATH {node:{t:"Die",target:{t:"DieIdent",name:nm,l:obj.l},l:expr.l}, pos: mr.pos};
    }
    // Optional semicolon
    BIRTH mr WITH matchTok(toks, p, ";");
    BEQUEATH {node: {t:"ExprStmt",expr:expr,l:expr.l}, pos: mr.pos};
}

// --- Import ---
RITE parseImport(toks, pos) {
    BIRTH l WITH toks[pos].l;
    pos = pos + 1; // consume 'import'
    BIRTH ety WITH toks[pos].t;
    SHOULD ety != "timer" AND ety != "process" AND ety != "connection"
       AND ety != "watcher" AND ety != "session" {
        CONDEMN "Expected entity type at line " + STRING(toks[pos].l);
    }
    pos = pos + 1;
    BIRTH unsafeFlag WITH DEAD;
    SHOULD ety == "session" AND toks[pos].t == "UNSAFE" {
        unsafeFlag = ALIVE;
        pos = pos + 1;
    }
    SHOULD toks[pos].t != "ID" { CONDEMN "Expected entity name at line " + STRING(toks[pos].l); }
    BIRTH nm WITH toks[pos].v;
    pos = pos + 1;
    pos = expect(toks, pos, "(");
    BIRTH args WITH [];
    SHOULD ety == "timer" {
        SHOULD toks[pos].t == "DUR" {
            args = APPEND(args, {t:"Duration",ms:toks[pos].v,l:toks[pos].l});
            pos = pos + 1;
        } LEST SHOULD toks[pos].t == "INT" {
            args = APPEND(args, {t:"Duration",ms:toks[pos].v,l:toks[pos].l});
            pos = pos + 1;
        } LEST {
            CONDEMN "Expected duration for timer at line " + STRING(toks[pos].l);
        }
    } LEST {
        SHOULD toks[pos].t != ")" {
            BIRTH ra WITH parseExpr(toks, pos);
            args = APPEND(args, ra.node);
            pos = ra.pos;
            BIRTH parsing WITH ALIVE;
            SHOULD toks[pos].t == "," {
                pos = pos + 1;
                BIRTH ra2 WITH parseExpr(toks, pos);
                args = APPEND(args, ra2.node);
                pos = ra2.pos;
            }
            SHOULD toks[pos].t == "," {
                pos = pos + 1;
                BIRTH ra3 WITH parseExpr(toks, pos);
                args = APPEND(args, ra3.node);
                pos = ra3.pos;
            }
        }
    }
    pos = expect(toks, pos, ")");
    BIRTH transcriptions WITH [];
    BIRTH hadBlock WITH DEAD;
    SHOULD ety == "session" AND toks[pos].t == "{" {
        pos = pos + 1; // consume '{'
        BIRTH tr WITH parseTranscriptions(toks, pos, []);
        transcriptions = tr.list;
        pos = tr.pos;
        pos = expect(toks, pos, "}");
        hadBlock = ALIVE;
    }
    // Blocks self-terminate (no ; required); plain imports need ;.
    SHOULD hadBlock {
        BIRTH mr WITH matchTok(toks, pos, ";");
        SHOULD mr.matched { pos = mr.pos; }
    } LEST {
        pos = expect(toks, pos, ";");
    }
    BEQUEATH {node: {t:"Import",etype:ety,name:nm,args:args,
                     unsafe:unsafeFlag,transcriptions:transcriptions,l:l}, pos: pos};
}

// --- Transcription block (session only) ---
// Grammar: '{' TRANSCRIBE name '(' typespec (',' typespec)* ')' '->' typespec [ 'DROPS' name ] ';'  ... '}'
RITE parseTranscriptions(toks, pos, acc) {
    SHOULD toks[pos].t == "}" OR toks[pos].t == "EOF" {
        BEQUEATH {list: acc, pos: pos};
    }
    BIRTH r WITH parseTranscription(toks, pos);
    BEQUEATH parseTranscriptions(toks, r.pos, APPEND(acc, r.node));
}

RITE parseTranscription(toks, pos) {
    BIRTH l WITH toks[pos].l;
    pos = expect(toks, pos, "TRANSCRIBE");
    SHOULD toks[pos].t != "ID" {
        CONDEMN "Expected transcribed name at line " + STRING(toks[pos].l);
    }
    BIRTH nm WITH toks[pos].v;
    pos = pos + 1;
    pos = expect(toks, pos, "(");
    BIRTH pl WITH parseTransParams(toks, pos, []);
    pos = pl.pos;
    pos = expect(toks, pos, ")");
    pos = expectArrow(toks, pos);
    BIRTH rt WITH parseTypeSpec(toks, pos);
    pos = rt.pos;
    BIRTH drops WITH "";
    SHOULD toks[pos].t == "DROPS" {
        pos = pos + 1;
        SHOULD toks[pos].t != "ID" {
            CONDEMN "Expected destructor name after DROPS at line " + STRING(toks[pos].l);
        }
        drops = toks[pos].v;
        pos = pos + 1;
    }
    pos = expect(toks, pos, ";");
    BEQUEATH {node: {t:"Transcribe",name:nm,params:pl.list,ret:rt.node,
                     drops:drops,l:l}, pos: pos};
}

RITE parseTransParams(toks, pos, acc) {
    SHOULD toks[pos].t == ")" {
        BEQUEATH {list: acc, pos: pos};
    }
    BIRTH pr WITH parseTypeSpec(toks, pos);
    BIRTH newAcc WITH APPEND(acc, pr.node);
    SHOULD toks[pr.pos].t == "," {
        BEQUEATH parseTransParams(toks, pr.pos + 1, newAcc);
    }
    BEQUEATH {list: newAcc, pos: pr.pos};
}

// '->' is two adjacent tokens '-' then '>' in the lexer
RITE expectArrow(toks, pos) {
    pos = expect(toks, pos, "-");
    pos = expect(toks, pos, ">");
    BEQUEATH pos;
}

// Type names are bare identifiers (INTEGER, FLOAT, STRING, BOOLEAN, VOID, RELIC, BUFFER), or 'CALLBACK' '(' types ')' '->' type. VOID is a real keyword in the lexer; the rest tokenize as IDs.
RITE parseTypeSpec(toks, pos) {
    BIRTH l WITH toks[pos].l;
    BIRTH name WITH "";
    SHOULD toks[pos].t == "VOID" {
        name = "VOID";
        pos = pos + 1;
    } LEST SHOULD toks[pos].t == "ID" {
        name = toks[pos].v;
        pos = pos + 1;
    } LEST {
        CONDEMN "Expected type name at line " + STRING(toks[pos].l);
    }
    SHOULD name == "CALLBACK" {
        pos = expect(toks, pos, "(");
        BIRTH pl WITH parseTransParams(toks, pos, []);
        pos = pl.pos;
        pos = expect(toks, pos, ")");
        pos = expectArrow(toks, pos);
        BIRTH rt WITH parseTypeSpec(toks, pos);
        BEQUEATH {node: {t:"Type",n:"CALLBACK",params:pl.list,ret:rt.node,l:l},
                  pos: rt.pos};
    }
    // A dotted name (e.g. Geo.Point) references a !^CAKE recipe imported as a
    // module; resolved to an AthRecipe at transcribe time for by-value structs.
    BIRTH dt WITH parseDottedTail(toks, pos, name);
    BEQUEATH {node: {t:"Type",n:dt.name,l:l}, pos: dt.pos};
}

RITE parseDottedTail(toks, pos, name) {
    SHOULD toks[pos].t == "." AND toks[pos+1].t == "ID" {
        BEQUEATH parseDottedTail(toks, pos+2, name + "." + toks[pos+1].v);
    }
    BEQUEATH {name: name, pos: pos};
}

// --- BANISH ---
RITE parseBanish(toks, pos) {
    BIRTH l WITH toks[pos].l;
    pos = pos + 1; // consume BANISH
    BIRTH re WITH parseExpr(toks, pos);
    pos = re.pos;
    pos = expect(toks, pos, ";");
    BEQUEATH {node: {t:"Banish",expr:re.node,l:l}, pos: pos};
}

// --- Bifurcate ---
RITE parseBifurcate(toks, pos) {
    BIRTH l WITH toks[pos].l;
    pos = pos + 1;
    BIRTH ent WITH toks[pos].v;
    pos = pos + 1; // entity name (ID or THIS)
    pos = expect(toks, pos, "[");
    SHOULD toks[pos].t != "ID" { CONDEMN "Expected branch name at line " + STRING(toks[pos].l); }
    BIRTH br1 WITH toks[pos].v; pos = pos + 1;
    pos = expect(toks, pos, ",");
    SHOULD toks[pos].t != "ID" { CONDEMN "Expected branch name at line " + STRING(toks[pos].l); }
    BIRTH br2 WITH toks[pos].v; pos = pos + 1;
    pos = expect(toks, pos, "]");
    pos = expect(toks, pos, ";");
    BEQUEATH {node: {t:"Bifurcate",entity:ent,br1:br1,br2:br2,l:l}, pos: pos};
}

// --- ~ATH loop ---
RITE parseAthLoop(toks, pos) {
    BIRTH l WITH toks[pos].l;
    pos = pos + 1; // consume ~ATH
    pos = expect(toks, pos, "(");
    BIRTH re WITH parseEntityExpr(toks, pos);
    BIRTH entity WITH re.node;
    pos = expect(toks, re.pos, ")");
    pos = expect(toks, pos, "{");
    BIRTH rb WITH parseStmtList(toks, pos, []);
    pos = expect(toks, rb.pos, "}");
    pos = expect(toks, pos, "EXECUTE");
    pos = expect(toks, pos, "(");
    BIRTH exec WITH parseExecuteBody(toks, pos, []);
    pos = expect(toks, exec.pos, ")");
    pos = expect(toks, pos, ";");
    BEQUEATH {node: {t:"AthLoop",entity:entity,body:rb.stmts,exec:exec.stmts,l:l}, pos: pos};
}

RITE parseStmtList(toks, pos, acc) {
    SHOULD toks[pos].t == "}" OR toks[pos].t == "EOF" {
        BEQUEATH {stmts: acc, pos: pos};
    }
    BIRTH r WITH parseStmt(toks, pos);
    BEQUEATH parseStmtList(toks, r.pos, APPEND(acc, r.node));
}

RITE parseExecuteBody(toks, pos, acc) {
    SHOULD toks[pos].t == ")" OR toks[pos].t == "EOF" {
        BEQUEATH {stmts: acc, pos: pos};
    }
    BIRTH r WITH parseExprStmt(toks, pos);
    BEQUEATH parseExecuteBody(toks, r.pos, APPEND(acc, r.node));
}

RITE parseExprStmtList(toks, pos, acc) {
    SHOULD toks[pos].t == "}" OR toks[pos].t == "EOF" {
        BEQUEATH {stmts: acc, pos: pos};
    }
    BIRTH r WITH parseExprStmt(toks, pos);
    BEQUEATH parseExprStmtList(toks, r.pos, APPEND(acc, r.node));
}

// --- DIE or assignment or expression ---
RITE parseDieOrAssignOrExpr(toks, pos) {
    SHOULD toks[pos].t == "[" {
        BIRTH rd WITH parseDieTarget(toks, pos);
        pos = expect(toks, rd.pos, ".");
        pos = expect(toks, pos, "DIE");
        pos = expect(toks, pos, "(");
        pos = expect(toks, pos, ")");
        pos = expect(toks, pos, ";");
        BEQUEATH {node: {t:"Die",target:rd.node,l:rd.node.l}, pos: pos};
    }
    BIRTH re WITH parseExpr(toks, pos);
    BIRTH expr WITH re.node;
    BIRTH p WITH re.pos;
    // Check for assignment
    SHOULD toks[p].t == "=" {
        p = p + 1;
        BIRTH rv WITH parseExpr(toks, p);
        p = expect(toks, rv.pos, ";");
        BEQUEATH {node:{t:"Assign",target:expr,val:rv.node,l:expr.l}, pos: p};
    }
    // Check for DIE call
    SHOULD expr.t == "Call" AND HAS(expr, "callee") AND expr.callee.t == "Member" AND expr.callee.mem == "DIE" {
        BIRTH obj WITH expr.callee.obj;
        BIRTH nm WITH obj.name;
        p = expect(toks, p, ";");
        BEQUEATH {node:{t:"Die",target:{t:"DieIdent",name:nm,l:obj.l},l:expr.l}, pos: p};
    }
    p = expect(toks, p, ";");
    BEQUEATH {node:{t:"ExprStmt",expr:expr,l:expr.l}, pos: p};
}

RITE parseDieTarget(toks, pos) {
    SHOULD toks[pos].t == "[" {
        BIRTH l WITH toks[pos].l;
        pos = pos + 1;
        BIRTH rl WITH parseDieTarget(toks, pos);
        pos = expect(toks, rl.pos, ",");
        BIRTH rr WITH parseDieTarget(toks, pos);
        pos = expect(toks, rr.pos, "]");
        BEQUEATH {node:{t:"DiePair",left:rl.node,right:rr.node,l:l}, pos: pos};
    }
    SHOULD toks[pos].t == "THIS" OR toks[pos].t == "ID" {
        BIRTH nm WITH toks[pos].v;
        BIRTH l WITH toks[pos].l;
        BEQUEATH {node:{t:"DieIdent",name:nm,l:l}, pos: pos+1};
    }
    CONDEMN "Expected die target at line " + STRING(toks[pos].l);
}

// --- VarDecl / ConstDecl ---
RITE parseVarDecl(toks, pos) {
    BIRTH l WITH toks[pos].l;
    pos = pos + 1;
    SHOULD toks[pos].t != "ID" { CONDEMN "Expected name at line " + STRING(toks[pos].l); }
    BIRTH nm WITH toks[pos].v; pos = pos + 1;
    pos = expect(toks, pos, "WITH");
    BIRTH re WITH parseExpr(toks, pos);
    pos = expect(toks, re.pos, ";");
    BEQUEATH {node:{t:"VarDecl",name:nm,val:re.node,l:l}, pos: pos};
}

RITE parseConstDecl(toks, pos) {
    BIRTH l WITH toks[pos].l;
    pos = pos + 1;
    SHOULD toks[pos].t != "ID" { CONDEMN "Expected name at line " + STRING(toks[pos].l); }
    BIRTH nm WITH toks[pos].v; pos = pos + 1;
    pos = expect(toks, pos, "WITH");
    BIRTH re WITH parseExpr(toks, pos);
    pos = expect(toks, re.pos, ";");
    BEQUEATH {node:{t:"ConstDecl",name:nm,val:re.node,l:l}, pos: pos};
}

// --- RiteDef ---
RITE parseRiteDef(toks, pos) {
    BIRTH l WITH toks[pos].l;
    pos = pos + 1;
    SHOULD toks[pos].t != "ID" { CONDEMN "Expected rite name at line " + STRING(toks[pos].l); }
    BIRTH nm WITH toks[pos].v; pos = pos + 1;
    pos = expect(toks, pos, "(");
    BIRTH params WITH [];
    SHOULD toks[pos].t != ")" {
        SHOULD toks[pos].t != "ID" { CONDEMN "Expected param at line " + STRING(toks[pos].l); }
        params = APPEND(params, toks[pos].v);
        pos = pos + 1;
        BIRTH moreparams WITH ALIVE;
        SHOULD toks[pos].t == "," { pos = pos + 1;
            SHOULD toks[pos].t != "ID" { CONDEMN "Expected param at line " + STRING(toks[pos].l); }
            params = APPEND(params, toks[pos].v); pos = pos + 1; }
        SHOULD toks[pos].t == "," { pos = pos + 1;
            SHOULD toks[pos].t != "ID" { CONDEMN "Expected param at line " + STRING(toks[pos].l); }
            params = APPEND(params, toks[pos].v); pos = pos + 1; }
        SHOULD toks[pos].t == "," { pos = pos + 1;
            SHOULD toks[pos].t != "ID" { CONDEMN "Expected param at line " + STRING(toks[pos].l); }
            params = APPEND(params, toks[pos].v); pos = pos + 1; }
        SHOULD toks[pos].t == "," { pos = pos + 1;
            SHOULD toks[pos].t != "ID" { CONDEMN "Expected param at line " + STRING(toks[pos].l); }
            params = APPEND(params, toks[pos].v); pos = pos + 1; }
        SHOULD toks[pos].t == "," { pos = pos + 1;
            SHOULD toks[pos].t != "ID" { CONDEMN "Expected param at line " + STRING(toks[pos].l); }
            params = APPEND(params, toks[pos].v); pos = pos + 1; }
        SHOULD toks[pos].t == "," { pos = pos + 1;
            SHOULD toks[pos].t != "ID" { CONDEMN "Expected param at line " + STRING(toks[pos].l); }
            params = APPEND(params, toks[pos].v); pos = pos + 1; }
        SHOULD toks[pos].t == "," { pos = pos + 1;
            SHOULD toks[pos].t != "ID" { CONDEMN "Expected param at line " + STRING(toks[pos].l); }
            params = APPEND(params, toks[pos].v); pos = pos + 1; }
        SHOULD toks[pos].t == "," { pos = pos + 1;
            SHOULD toks[pos].t != "ID" { CONDEMN "Expected param at line " + STRING(toks[pos].l); }
            params = APPEND(params, toks[pos].v); pos = pos + 1; }
    }
    pos = expect(toks, pos, ")");
    pos = expect(toks, pos, "{");
    BIRTH rb WITH parseExprStmtList(toks, pos, []);
    pos = expect(toks, rb.pos, "}");
    BEQUEATH {node:{t:"RiteDef",name:nm,params:params,body:rb.stmts,l:l}, pos: pos};
}

// --- Conditional ---
RITE parseCond(toks, pos) {
    BIRTH l WITH toks[pos].l;
    pos = pos + 1;
    BIRTH rc WITH parseExpr(toks, pos);
    pos = expect(toks, rc.pos, "{");
    BIRTH rt WITH parseExprStmtList(toks, pos, []);
    pos = expect(toks, rt.pos, "}");
    BIRTH els WITH VOID;
    SHOULD toks[pos].t == "LEST" {
        pos = pos + 1;
        SHOULD toks[pos].t == "SHOULD" {
            BIRTH ri WITH parseCond(toks, pos);
            els = [ri.node];
            pos = ri.pos;
        } LEST {
            pos = expect(toks, pos, "{");
            BIRTH re WITH parseExprStmtList(toks, pos, []);
            els = re.stmts;
            pos = expect(toks, re.pos, "}");
        }
    }
    BEQUEATH {node:{t:"Cond",cond:rc.node,then:rt.stmts,els:els,l:l}, pos: pos};
}

// --- AttemptSalvage ---
RITE parseAttemptSalvage(toks, pos) {
    BIRTH l WITH toks[pos].l;
    pos = pos + 1;
    pos = expect(toks, pos, "{");
    BIRTH ra WITH parseExprStmtList(toks, pos, []);
    pos = expect(toks, ra.pos, "}");
    pos = expect(toks, pos, "SALVAGE");
    SHOULD toks[pos].t != "ID" { CONDEMN "Expected error var at line " + STRING(toks[pos].l); }
    BIRTH en WITH toks[pos].v; pos = pos + 1;
    pos = expect(toks, pos, "{");
    BIRTH rs WITH parseExprStmtList(toks, pos, []);
    pos = expect(toks, rs.pos, "}");
    BEQUEATH {node:{t:"AttemptSalvage",attempt:ra.stmts,errname:en,salvage:rs.stmts,l:l}, pos: pos};
}

// --- Condemn ---
RITE parseCondemnStmt(toks, pos) {
    BIRTH l WITH toks[pos].l;
    pos = pos + 1;
    BIRTH re WITH parseExpr(toks, pos);
    pos = expect(toks, re.pos, ";");
    BEQUEATH {node:{t:"Condemn",msg:re.node,l:l}, pos: pos};
}

// --- Bequeath ---
RITE parseBequeathStmt(toks, pos) {
    BIRTH l WITH toks[pos].l;
    pos = pos + 1;
    SHOULD toks[pos].t == ";" {
        BEQUEATH {node:{t:"Bequeath",val:{t:"Lit",vt:"VOID",v:VOID},l:l}, pos: pos+1};
    }
    BIRTH re WITH parseExpr(toks, pos);
    pos = expect(toks, re.pos, ";");
    BEQUEATH {node:{t:"Bequeath",val:re.node,l:l}, pos: pos};
}

// --- Entity expressions ---
RITE parseEntityExpr(toks, pos) { BEQUEATH parseEntityOr(toks, pos); }

RITE parseEntityOr(toks, pos) {
    BIRTH rl WITH parseEntityAnd(toks, pos);
    BIRTH left WITH rl.node;
    pos = rl.pos;
    SHOULD toks[pos].t == "||" {
        pos = pos + 1;
        BIRTH rr WITH parseEntityAnd(toks, pos);
        BEQUEATH {node:{t:"EntityOr",left:left,right:rr.node,l:left.l}, pos: rr.pos};
    }
    BEQUEATH {node: left, pos: pos};
}

RITE parseEntityAnd(toks, pos) {
    BIRTH rl WITH parseEntityUnary(toks, pos);
    BIRTH left WITH rl.node;
    pos = rl.pos;
    SHOULD toks[pos].t == "&&" {
        pos = pos + 1;
        BIRTH rr WITH parseEntityUnary(toks, pos);
        BEQUEATH {node:{t:"EntityAnd",left:left,right:rr.node,l:left.l}, pos: rr.pos};
    }
    BEQUEATH {node: left, pos: pos};
}

RITE parseEntityUnary(toks, pos) {
    SHOULD toks[pos].t == "!" {
        BIRTH l WITH toks[pos].l;
        pos = pos + 1;
        BIRTH ro WITH parseEntityUnary(toks, pos);
        BEQUEATH {node:{t:"EntityNot",operand:ro.node,l:l}, pos: ro.pos};
    }
    BEQUEATH parseEntityPrimary(toks, pos);
}

RITE parseEntityPrimary(toks, pos) {
    SHOULD toks[pos].t == "(" {
        pos = pos + 1;
        BIRTH re WITH parseEntityExpr(toks, pos);
        pos = expect(toks, re.pos, ")");
        BEQUEATH {node: re.node, pos: pos};
    }
    SHOULD toks[pos].t == "THIS" OR toks[pos].t == "ID" {
        BIRTH nm WITH toks[pos].v;
        BIRTH l WITH toks[pos].l;
        BEQUEATH {node:{t:"EntityIdent",name:nm,l:l}, pos: pos+1};
    }
    CONDEMN "Expected entity at line " + STRING(toks[pos].l);
}

// --- Expressions ---
RITE parseExpr(toks, pos) { BEQUEATH parseOr(toks, pos); }

RITE parseOr(toks, pos) {
    BIRTH rl WITH parseAnd(toks, pos);
    pos = rl.pos;
    SHOULD toks[pos].t == "OR" {
        pos = pos + 1;
        BIRTH rr WITH parseAnd(toks, pos);
        BEQUEATH continueOrs(toks, rr.pos, {t:"BinOp",op:"OR",left:rl.node,right:rr.node,l:rl.node.l});
    }
    BEQUEATH {node: rl.node, pos: pos};
}

RITE continueOrs(toks, pos, left) {
    SHOULD toks[pos].t == "OR" {
        pos = pos + 1;
        BIRTH rr WITH parseAnd(toks, pos);
        BEQUEATH continueOrs(toks, rr.pos, {t:"BinOp",op:"OR",left:left,right:rr.node,l:left.l});
    }
    BEQUEATH {node: left, pos: pos};
}

RITE parseAnd(toks, pos) {
    BIRTH rl WITH parseEq(toks, pos);
    pos = rl.pos;
    SHOULD toks[pos].t == "AND" {
        pos = pos + 1;
        BIRTH rr WITH parseEq(toks, pos);
        BEQUEATH continueAnds(toks, rr.pos, {t:"BinOp",op:"AND",left:rl.node,right:rr.node,l:rl.node.l});
    }
    BEQUEATH {node: rl.node, pos: pos};
}

RITE continueAnds(toks, pos, left) {
    SHOULD toks[pos].t == "AND" {
        pos = pos + 1;
        BIRTH rr WITH parseEq(toks, pos);
        BEQUEATH continueAnds(toks, rr.pos, {t:"BinOp",op:"AND",left:left,right:rr.node,l:left.l});
    }
    BEQUEATH {node: left, pos: pos};
}

RITE parseEq(toks, pos) {
    BIRTH rl WITH parseCmp(toks, pos);
    pos = rl.pos;
    SHOULD toks[pos].t == "==" OR toks[pos].t == "!=" {
        BIRTH op WITH toks[pos].t; pos = pos + 1;
        BIRTH rr WITH parseCmp(toks, pos);
        BEQUEATH continueEqs(toks, rr.pos, {t:"BinOp",op:op,left:rl.node,right:rr.node,l:rl.node.l});
    }
    BEQUEATH {node: rl.node, pos: pos};
}

RITE continueEqs(toks, pos, left) {
    SHOULD toks[pos].t == "==" OR toks[pos].t == "!=" {
        BIRTH op WITH toks[pos].t; pos = pos + 1;
        BIRTH rr WITH parseCmp(toks, pos);
        BEQUEATH continueEqs(toks, rr.pos, {t:"BinOp",op:op,left:left,right:rr.node,l:left.l});
    }
    BEQUEATH {node: left, pos: pos};
}

RITE parseCmp(toks, pos) {
    BIRTH rl WITH parseBitOr(toks, pos);
    pos = rl.pos;
    SHOULD toks[pos].t == "<" OR toks[pos].t == ">" OR toks[pos].t == "<=" OR toks[pos].t == ">=" {
        BIRTH op WITH toks[pos].t; pos = pos + 1;
        BIRTH rr WITH parseBitOr(toks, pos);
        BEQUEATH continueCmps(toks, rr.pos, {t:"BinOp",op:op,left:rl.node,right:rr.node,l:rl.node.l});
    }
    BEQUEATH {node: rl.node, pos: pos};
}

RITE continueCmps(toks, pos, left) {
    SHOULD toks[pos].t == "<" OR toks[pos].t == ">" OR toks[pos].t == "<=" OR toks[pos].t == ">=" {
        BIRTH op WITH toks[pos].t; pos = pos + 1;
        BIRTH rr WITH parseBitOr(toks, pos);
        BEQUEATH continueCmps(toks, rr.pos, {t:"BinOp",op:op,left:left,right:rr.node,l:left.l});
    }
    BEQUEATH {node: left, pos: pos};
}

RITE parseBitOr(toks, pos) {
    BIRTH rl WITH parseBitXor(toks, pos);
    pos = rl.pos;
    SHOULD toks[pos].t == "|" {
        pos = pos + 1;
        BIRTH rr WITH parseBitXor(toks, pos);
        BEQUEATH continueBitOrs(toks, rr.pos, {t:"BinOp",op:"|",left:rl.node,right:rr.node,l:rl.node.l});
    }
    BEQUEATH {node: rl.node, pos: pos};
}

RITE continueBitOrs(toks, pos, left) {
    SHOULD toks[pos].t == "|" {
        pos = pos + 1;
        BIRTH rr WITH parseBitXor(toks, pos);
        BEQUEATH continueBitOrs(toks, rr.pos, {t:"BinOp",op:"|",left:left,right:rr.node,l:left.l});
    }
    BEQUEATH {node: left, pos: pos};
}

RITE parseBitXor(toks, pos) {
    BIRTH rl WITH parseBitAnd(toks, pos);
    pos = rl.pos;
    SHOULD toks[pos].t == "^" {
        pos = pos + 1;
        BIRTH rr WITH parseBitAnd(toks, pos);
        BEQUEATH continueBitXors(toks, rr.pos, {t:"BinOp",op:"^",left:rl.node,right:rr.node,l:rl.node.l});
    }
    BEQUEATH {node: rl.node, pos: pos};
}

RITE continueBitXors(toks, pos, left) {
    SHOULD toks[pos].t == "^" {
        pos = pos + 1;
        BIRTH rr WITH parseBitAnd(toks, pos);
        BEQUEATH continueBitXors(toks, rr.pos, {t:"BinOp",op:"^",left:left,right:rr.node,l:left.l});
    }
    BEQUEATH {node: left, pos: pos};
}

RITE parseBitAnd(toks, pos) {
    BIRTH rl WITH parseShift(toks, pos);
    pos = rl.pos;
    SHOULD toks[pos].t == "&" {
        pos = pos + 1;
        BIRTH rr WITH parseShift(toks, pos);
        BEQUEATH continueBitAnds(toks, rr.pos, {t:"BinOp",op:"&",left:rl.node,right:rr.node,l:rl.node.l});
    }
    BEQUEATH {node: rl.node, pos: pos};
}

RITE continueBitAnds(toks, pos, left) {
    SHOULD toks[pos].t == "&" {
        pos = pos + 1;
        BIRTH rr WITH parseShift(toks, pos);
        BEQUEATH continueBitAnds(toks, rr.pos, {t:"BinOp",op:"&",left:left,right:rr.node,l:left.l});
    }
    BEQUEATH {node: left, pos: pos};
}

RITE parseShift(toks, pos) {
    BIRTH rl WITH parseTerm(toks, pos);
    pos = rl.pos;
    SHOULD toks[pos].t == "<<" OR toks[pos].t == ">>" {
        BIRTH op WITH toks[pos].t; pos = pos + 1;
        BIRTH rr WITH parseTerm(toks, pos);
        BEQUEATH continueShifts(toks, rr.pos, {t:"BinOp",op:op,left:rl.node,right:rr.node,l:rl.node.l});
    }
    BEQUEATH {node: rl.node, pos: pos};
}

RITE continueShifts(toks, pos, left) {
    SHOULD toks[pos].t == "<<" OR toks[pos].t == ">>" {
        BIRTH op WITH toks[pos].t; pos = pos + 1;
        BIRTH rr WITH parseTerm(toks, pos);
        BEQUEATH continueShifts(toks, rr.pos, {t:"BinOp",op:op,left:left,right:rr.node,l:left.l});
    }
    BEQUEATH {node: left, pos: pos};
}

RITE parseTerm(toks, pos) {
    BIRTH rl WITH parseFactor(toks, pos);
    BIRTH left WITH rl.node;
    pos = rl.pos;
    SHOULD toks[pos].t == "+" OR toks[pos].t == "-" {
        BIRTH op WITH toks[pos].t; pos = pos + 1;
        BIRTH rr WITH parseFactor(toks, pos);
        BIRTH r WITH {node:{t:"BinOp",op:op,left:left,right:rr.node,l:left.l}, pos: rr.pos};
        BEQUEATH continueTerms(toks, r.pos, r.node);
    }
    BEQUEATH {node: left, pos: pos};
}

RITE continueTerms(toks, pos, left) {
    SHOULD toks[pos].t == "+" OR toks[pos].t == "-" {
        BIRTH op WITH toks[pos].t; pos = pos + 1;
        BIRTH rr WITH parseFactor(toks, pos);
        BEQUEATH continueTerms(toks, rr.pos, {t:"BinOp",op:op,left:left,right:rr.node,l:left.l});
    }
    BEQUEATH {node: left, pos: pos};
}

RITE parseFactor(toks, pos) {
    BIRTH rl WITH parseUnary(toks, pos);
    BIRTH left WITH rl.node;
    pos = rl.pos;
    SHOULD toks[pos].t == "*" OR toks[pos].t == "/" OR toks[pos].t == "%" {
        BIRTH op WITH toks[pos].t; pos = pos + 1;
        BIRTH rr WITH parseUnary(toks, pos);
        BIRTH r WITH {node:{t:"BinOp",op:op,left:left,right:rr.node,l:left.l}, pos: rr.pos};
        BEQUEATH continueFactors(toks, r.pos, r.node);
    }
    BEQUEATH {node: left, pos: pos};
}

RITE continueFactors(toks, pos, left) {
    SHOULD toks[pos].t == "*" OR toks[pos].t == "/" OR toks[pos].t == "%" {
        BIRTH op WITH toks[pos].t; pos = pos + 1;
        BIRTH rr WITH parseUnary(toks, pos);
        BEQUEATH continueFactors(toks, rr.pos, {t:"BinOp",op:op,left:left,right:rr.node,l:left.l});
    }
    BEQUEATH {node: left, pos: pos};
}

RITE parseUnary(toks, pos) {
    SHOULD toks[pos].t == "NOT" {
        BIRTH l WITH toks[pos].l; pos = pos + 1;
        BIRTH ro WITH parseUnary(toks, pos);
        BEQUEATH {node:{t:"UnaryOp",op:"NOT",operand:ro.node,l:l}, pos: ro.pos};
    }
    SHOULD toks[pos].t == "-" {
        BIRTH l WITH toks[pos].l; pos = pos + 1;
        BIRTH ro WITH parseUnary(toks, pos);
        BEQUEATH {node:{t:"UnaryOp",op:"-",operand:ro.node,l:l}, pos: ro.pos};
    }
    SHOULD toks[pos].t == "~" {
        BIRTH l WITH toks[pos].l; pos = pos + 1;
        BIRTH ro WITH parseUnary(toks, pos);
        BEQUEATH {node:{t:"UnaryOp",op:"~",operand:ro.node,l:l}, pos: ro.pos};
    }
    BEQUEATH parsePostfix(toks, pos);
}

RITE parsePostfix(toks, pos) {
    BIRTH rp WITH parsePrimary(toks, pos);
    BEQUEATH continuePostfix(toks, rp.pos, rp.node);
}

RITE continuePostfix(toks, pos, expr) {
    SHOULD toks[pos].t == "[" {
        pos = pos + 1;
        BIRTH ri WITH parseExpr(toks, pos);
        pos = expect(toks, ri.pos, "]");
        BEQUEATH continuePostfix(toks, pos, {t:"Index",obj:expr,idx:ri.node,l:expr.l});
    }
    SHOULD toks[pos].t == "." {
        pos = pos + 1;
        // Special: .DIE is a keyword not identifier
        SHOULD toks[pos].t == "DIE" {
            BIRTH l WITH toks[pos].l; pos = pos + 1;
            pos = expect(toks, pos, "(");
            pos = expect(toks, pos, ")");
            BIRTH mem WITH {t:"Member",obj:expr,mem:"DIE",l:l};
            BEQUEATH continuePostfix(toks, pos, {t:"Call",callee:mem,args:[],l:l});
        }
        SHOULD toks[pos].t != "ID" { CONDEMN "Expected member name at line " + STRING(toks[pos].l); }
        BIRTH nm WITH toks[pos].v; BIRTH l WITH toks[pos].l; pos = pos + 1;
        BEQUEATH continuePostfix(toks, pos, {t:"Member",obj:expr,mem:nm,l:l});
    }
    SHOULD toks[pos].t == "(" {
        pos = pos + 1;
        BIRTH ra WITH parseArgList(toks, pos, []);
        pos = expect(toks, ra.pos, ")");
        BEQUEATH continuePostfix(toks, pos, {t:"Call",callee:expr,args:ra.args,l:expr.l});
    }
    BEQUEATH {node: expr, pos: pos};
}

RITE parseArgList(toks, pos, args) {
    SHOULD toks[pos].t == ")" { BEQUEATH {args: args, pos: pos}; }
    BIRTH re WITH parseExpr(toks, pos);
    BIRTH newArgs WITH APPEND(args, re.node);
    pos = re.pos;
    SHOULD toks[pos].t == "," {
        BEQUEATH parseArgList(toks, pos+1, newArgs);
    }
    BEQUEATH {args: newArgs, pos: pos};
}

RITE parsePrimary(toks, pos) {
    BIRTH ty WITH toks[pos].t;
    BIRTH l WITH toks[pos].l;
    BIRTH v WITH toks[pos].v;
    SHOULD ty == "INT"  { BEQUEATH {node:{t:"Lit",vt:"INT", v:v,l:l}, pos:pos+1}; }
    SHOULD ty == "FLT"  { BEQUEATH {node:{t:"Lit",vt:"FLT", v:v,l:l}, pos:pos+1}; }
    SHOULD ty == "STR"  { BEQUEATH {node:{t:"Lit",vt:"STR", v:v,l:l}, pos:pos+1}; }
    SHOULD ty == "BOOL" { BEQUEATH {node:{t:"Lit",vt:"BOOL",v:v,l:l}, pos:pos+1}; }
    SHOULD ty == "VOID" { BEQUEATH {node:{t:"Lit",vt:"VOID",v:VOID,l:l}, pos:pos+1}; }
    SHOULD ty == "THIS" { BEQUEATH {node:{t:"Ident",name:"THIS",l:l}, pos:pos+1}; }
    SHOULD ty == "ID"   { BEQUEATH {node:{t:"Ident",name:v,l:l}, pos:pos+1}; }
    SHOULD ty == "EJECT" { BEQUEATH parseEject(toks, pos); }
    SHOULD ty == "STACK" OR ty == "QUEUE" OR ty == "TREE" OR ty == "HASHMAP"
        OR ty == "OUIJA" OR ty == "BOTTLE" OR ty == "TECHHOP" OR ty == "JUJU" {
        BEQUEATH parseSylladexCtor(toks, pos);
    }
    SHOULD ty == "(" {
        pos = pos + 1;
        BIRTH re WITH parseExpr(toks, pos);
        pos = expect(toks, re.pos, ")");
        BEQUEATH {node: re.node, pos: pos};
    }
    SHOULD ty == "[" {
        pos = pos + 1;
        BIRTH ra WITH parseArrayElements(toks, pos, []);
        pos = expect(toks, ra.pos, "]");
        BEQUEATH {node:{t:"Array",elems:ra.elems,l:l}, pos:pos};
    }
    SHOULD ty == "{" {
        pos = pos + 1;
        BIRTH rm WITH parseMapEntries(toks, pos, []);
        pos = expect(toks, rm.pos, "}");
        BEQUEATH {node:{t:"Map",entries:rm.entries,l:l}, pos:pos};
    }
    CONDEMN "Unexpected token in expression: " + ty + " at line " + STRING(l);
}

RITE parseArrayElements(toks, pos, elems) {
    SHOULD toks[pos].t == "]" { BEQUEATH {elems: elems, pos: pos}; }
    BIRTH re WITH parseExpr(toks, pos);
    BIRTH newElems WITH APPEND(elems, re.node);
    pos = re.pos;
    SHOULD toks[pos].t == "," {
        BIRTH mr WITH matchTok(toks, pos+1, "]");
        SHOULD mr.matched { BEQUEATH {elems: newElems, pos: pos+1}; }
        BEQUEATH parseArrayElements(toks, pos+1, newElems);
    }
    BEQUEATH {elems: newElems, pos: pos};
}

RITE parseMapEntries(toks, pos, entries) {
    SHOULD toks[pos].t == "}" { BEQUEATH {entries: entries, pos: pos}; }
    SHOULD toks[pos].t != "ID" AND toks[pos].t != "STR" {
        CONDEMN "Expected map key at line " + STRING(toks[pos].l);
    }
    BIRTH key WITH toks[pos].v; pos = pos + 1;
    pos = expect(toks, pos, ":");
    BIRTH rv WITH parseExpr(toks, pos);
    BIRTH newEntries WITH APPEND(entries, {key: key, val: rv.node});
    pos = rv.pos;
    SHOULD toks[pos].t == "," {
        BIRTH mr WITH matchTok(toks, pos+1, "}");
        SHOULD mr.matched { BEQUEATH {entries: newEntries, pos: pos+1}; }
        BEQUEATH parseMapEntries(toks, pos+1, newEntries);
    }
    BEQUEATH {entries: newEntries, pos: pos};
}

// Fix: parseExprStmt assignment - correct expect call
RITE parseAssignExprStmt(toks, pos) {
    BIRTH re WITH parseExpr(toks, pos);
    BIRTH expr WITH re.node;
    BIRTH p WITH re.pos;
    SHOULD toks[p].t == "=" {
        p = p + 1;
        BIRTH rv WITH parseExpr(toks, p);
        SHOULD toks[rv.pos].t != ";" { CONDEMN "Expected ; after assignment at line " + STRING(toks[rv.pos].l); }
        BEQUEATH {node:{t:"Assign",target:expr,val:rv.node,l:expr.l}, pos: rv.pos+1};
    }
    SHOULD expr.t == "Call" AND HAS(expr, "callee") AND expr.callee.t == "Member" AND expr.callee.mem == "DIE" {
        SHOULD toks[p].t != ";" { CONDEMN "Expected ; after DIE at line " + STRING(toks[p].l); }
        BIRTH obj WITH expr.callee.obj;
        BEQUEATH {node:{t:"Die",target:{t:"DieIdent",name:obj.name,l:obj.l},l:expr.l}, pos: p+1};
    }
    SHOULD toks[p].t != ";" { CONDEMN "Expected ; after expression at line " + STRING(toks[p].l); }
    BEQUEATH {node:{t:"ExprStmt",expr:expr,l:expr.l}, pos: p+1};
}

// --- !~ATH 2.0: CAPTCHALOGUE statement ---
RITE parseCaptchalogue(toks, pos) {
    BIRTH l WITH toks[pos].l;
    pos = pos + 1; // consume CAPTCHALOGUE
    BIRTH rv WITH parseExpr(toks, pos);
    BIRTH val WITH rv.node;
    pos = rv.pos;
    BIRTH withKey WITH VOID;
    SHOULD toks[pos].t == "WITH" {
        pos = pos + 1;
        BIRTH rk WITH parseExpr(toks, pos);
        withKey = rk.node;
        pos = rk.pos;
    }
    pos = expect(toks, pos, "INTO");
    BIRTH rt WITH parseExpr(toks, pos);
    BIRTH target WITH rt.node;
    pos = rt.pos;
    BIRTH slotIdx WITH VOID;
    SHOULD toks[pos].t == "SLOT" {
        pos = pos + 1;
        BIRTH rs WITH parseExpr(toks, pos);
        slotIdx = rs.node;
        pos = rs.pos;
    }
    pos = expect(toks, pos, ";");
    BEQUEATH {node:{t:"Captchalogue", value:val, withKey:withKey,
                    target:target, slotIdx:slotIdx, l:l}, pos: pos};
}

// --- !~ATH 2.0: EJECT expression with modifier disambiguation ---
RITE parseEject(toks, pos) {
    BIRTH l WITH toks[pos].l;
    pos = pos + 1; // consume EJECT
    BIRTH nt WITH toks[pos].t;
    SHOULD nt == "FROM" {
        pos = pos + 1;
        BIRTH rt WITH parseExpr(toks, pos);
        BEQUEATH {node:{t:"Eject", mod:"NONE", a:VOID, b:VOID,
                        target:rt.node, l:l}, pos: rt.pos};
    }
    SHOULD nt == "ROOT" {
        pos = pos + 1;
        pos = expect(toks, pos, "FROM");
        BIRTH rt WITH parseExpr(toks, pos);
        BEQUEATH {node:{t:"Eject", mod:"ROOT", a:VOID, b:VOID,
                        target:rt.node, l:l}, pos: rt.pos};
    }
    SHOULD nt == "LEAF" {
        pos = pos + 1;
        pos = expect(toks, pos, "FROM");
        BIRTH rt WITH parseExpr(toks, pos);
        BEQUEATH {node:{t:"Eject", mod:"LEAF", a:VOID, b:VOID,
                        target:rt.node, l:l}, pos: rt.pos};
    }
    SHOULD nt == "SLOT" {
        pos = pos + 1;
        BIRTH ra WITH parseExpr(toks, pos);
        pos = expect(toks, ra.pos, "FROM");
        BIRTH rt WITH parseExpr(toks, pos);
        BEQUEATH {node:{t:"Eject", mod:"SLOT", a:ra.node, b:VOID,
                        target:rt.node, l:l}, pos: rt.pos};
    }
    SHOULD nt == "GROOVE" {
        pos = pos + 1;
        BIRTH ra WITH parseExpr(toks, pos);
        pos = expect(toks, ra.pos, "SHADE");
        BIRTH rb WITH parseExpr(toks, pos);
        pos = expect(toks, rb.pos, "FROM");
        BIRTH rt WITH parseExpr(toks, pos);
        BEQUEATH {node:{t:"Eject", mod:"GROOVE_SHADE", a:ra.node, b:rb.node,
                        target:rt.node, l:l}, pos: rt.pos};
    }
    // Default: hashmap by-name key expression
    BIRTH ra WITH parseExpr(toks, pos);
    pos = expect(toks, ra.pos, "FROM");
    BIRTH rt WITH parseExpr(toks, pos);
    BEQUEATH {node:{t:"Eject", mod:"KEY", a:ra.node, b:VOID,
                    target:rt.node, l:l}, pos: rt.pos};
}

// --- !~ATH 2.0: sylladex constructor (STACK(n), HASHMAP(n, rite), ...) ---
RITE parseSylladexCtor(toks, pos) {
    BIRTH kind WITH toks[pos].t;
    BIRTH l WITH toks[pos].l;
    pos = pos + 1;
    pos = expect(toks, pos, "(");
    BIRTH ra WITH parseArgList(toks, pos, []);
    pos = expect(toks, ra.pos, ")");
    BEQUEATH {node:{t:"Sylladex", kind:kind, args:ra.args, l:l}, pos: pos};
}

