// Windows counterpart to test_large_integer_fits_in_long. !~ATH integers are
// C long, which is 64-bit on LP64 Linux but 32-bit on Windows (LLP64), so
// 1000000000 * 1000 = 10^12 overflows and wraps to a 32-bit signed value.
            BIRTH x WITH 1000000000;
            UTTER(x * 1000);
            THIS.DIE();
