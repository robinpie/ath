
        BIRTH counter WITH 0;
        bifurcate THIS[LEFT, RIGHT];

        ~ATH(LEFT) {
            import timer T1(1ms);
            ~ATH(T1) { } EXECUTE(
                counter = counter + 1;
            );
        } EXECUTE(VOID);

        ~ATH(RIGHT) {
            import timer T2(2ms);
            ~ATH(T2) { } EXECUTE(
                counter = counter + 10;
            );
        } EXECUTE(VOID);

        import timer wait(10ms);
        ~ATH(wait) { } EXECUTE(UTTER(counter));

        [LEFT, RIGHT].DIE();
    