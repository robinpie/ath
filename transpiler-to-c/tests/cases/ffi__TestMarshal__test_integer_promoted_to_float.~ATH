// Spec: "INTEGER is auto-promoted to double for FLOAT params."
import session L("libc.so.6") {
    TRANSCRIBE ldexp(FLOAT, INTEGER) -> FLOAT;
}
// Pass a plain INTEGER 1 where the C signature wants a double.
BIRTH r WITH L.ldexp(1, 3);
UTTER(r);
THIS.DIE();
