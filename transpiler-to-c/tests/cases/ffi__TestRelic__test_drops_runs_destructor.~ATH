// Spec: DROPS attaches a destructor that runs at session orderly death.
// Use fopen/fputs/fclose. Without the DROPS-fired fclose, the buffered
// "from-drops" bytes won't reach disk before we read the file.
import session L("libc.so.6") {
    TRANSCRIBE fopen(STRING, STRING) -> RELIC DROPS fclose;
    TRANSCRIBE fclose(RELIC) -> INTEGER;
    TRANSCRIBE fputs(STRING, RELIC) -> INTEGER;
}
BIRTH f WITH L.fopen("/tmp/_ath_test_drops.txt", "w");
L.fputs("from-drops\n", f);
L.DIE();
~ATH(L) {
} EXECUTE(
    UTTER(SCRY("/tmp/_ath_test_drops.txt"))
);
THIS.DIE();
