// !~ATH test harness.
//
// Reads manifest.txt (one "name|mode|stdin" line per corpus case), and for
// each case calls libruncase via an FFI session. libruncase transpiles
// cases/<name>.~ATH with the mainline transpiler, compiles it, runs it, and
// leaves the program output in work/<name>.actual. The harness then compares
// that output against cases/<name>.expected and tallies the result. A
// non-zero exit (via CONDEMN) signals any failure.
//
// Cases are run serially: the FFI call is synchronous, so each case fully
// completes (transpile + compile + run) before the next begins.

// ---------------------------------------------------------------------------
// Foreign session: per-case runner (transpile → compile → run).
// ---------------------------------------------------------------------------

import session RC("./work/libruncase.so") {
    TRANSCRIBE run_case(STRING, STRING) -> INTEGER;
    TRANSCRIBE ath_target() -> STRING;
};

// The harness has no getenv, so it asks libruncase which target the run is for
// ("native" or "win64"). Cases are filtered against this by their manifest
// platform field (see appliesTo / manifest format in README.md).
BIRTH target WITH RC.ath_target();

// ---------------------------------------------------------------------------
// Sorted-mode comparison.
//
// Bifurcated programs interleave their branches nondeterministically, so the
// corpus stores their expected output line-sorted and the harness compares
// line-sorted too. The sort is done by pouring the lines into a TREE and
// ejecting the root: an in-order traversal of a BST is sorted output.
// ---------------------------------------------------------------------------

RITE insertLines(t, parts, i, n) {
    SHOULD i < n {
        CAPTCHALOGUE parts[i] INTO t;
        insertLines(t, parts, i + 1, n);
    }
}

RITE sortText(text) {
    BIRTH t WITH TREE();
    BIRTH parts WITH SPLIT(TRIM(text), "\n");
    insertLines(t, parts, 0, LENGTH(parts));
    BIRTH ordered WITH EJECT ROOT FROM t;
    BEQUEATH JOIN(ordered, "\n");
}

RITE matches(actual, expected, mode) {
    SHOULD mode == "sorted" {
        BEQUEATH sortText(actual) == sortText(expected);
    }
    BEQUEATH actual == expected;
}

// ---------------------------------------------------------------------------
// Platform filtering.
//
// A manifest line's optional 4th field is a comma-separated list of targets the
// case applies to ("linux", "win64"). An empty/absent field means all targets.
// ---------------------------------------------------------------------------

RITE inList(parts, i, n, want) {
    SHOULD i < n {
        SHOULD TRIM(parts[i]) == want {
            BEQUEATH ALIVE;
        }
        BEQUEATH inList(parts, i + 1, n, want);
    }
    BEQUEATH DEAD;
}

RITE appliesTo(platforms, target) {
    BIRTH p WITH TRIM(platforms);
    SHOULD p == "" {
        BEQUEATH ALIVE;
    }
    BIRTH parts WITH SPLIT(p, ",");
    BEQUEATH inList(parts, 0, LENGTH(parts), target);
}

// ---------------------------------------------------------------------------
// Reporting.
// ---------------------------------------------------------------------------

RITE printFailures(failures, i, n) {
    SHOULD i < n {
        UTTER("    " + failures[i]);
        printFailures(failures, i + 1, n);
    }
}

RITE report(total, passed, failed, skipped, failures) {
    UTTER("");
    UTTER("==== !~ATH test harness (" + target + ") ====");
    UTTER("total:   ", total);
    UTTER("passed:  ", passed);
    UTTER("failed:  ", failed);
    UTTER("skipped: ", skipped);
    SHOULD failed > 0 {
        UTTER("failing cases:");
        printFailures(failures, 0, LENGTH(failures));
        CONDEMN "test failures";
    }
    UTTER("all tests passed");
}

// ---------------------------------------------------------------------------
// Case runner.  The FFI call is synchronous, so runCase is a plain
// recursive rite with no ~ATH waits.
// ---------------------------------------------------------------------------

BIRTH manifestRaw WITH SCRY("manifest.txt");
BIRTH lines WITH SPLIT(TRIM(manifestRaw), "\n");
BIRTH total WITH LENGTH(lines);

RITE runCase(i, passed, failed, skipped, failures) {
    SHOULD i >= total {
        report(total, passed, failed, skipped, failures);
        BEQUEATH VOID;
    }

    // Skip blank lines and comments silently
    BIRTH trimmed WITH TRIM(lines[i]);
    SHOULD trimmed == "" OR SUBSTRING(trimmed, 0, 1) == "#" {
        runCase(i + 1, passed, failed, skipped, failures);
        BEQUEATH VOID;
    }

    BIRTH fields WITH SPLIT(lines[i], "|");
    BIRTH name WITH fields[0];
    BIRTH mode WITH fields[1];
    BIRTH platforms WITH "";
    SHOULD LENGTH(fields) > 3 {
        platforms = fields[3];
    }

    // Skip cases that don't apply to the current target -- no transpile/run.
    SHOULD NOT appliesTo(platforms, target) {
        UTTER("  skip  " + name);
        runCase(i + 1, passed, failed, skipped + 1, failures);
        BEQUEATH VOID;
    }

    RC.run_case(name, "../athtoc-bin");

    BIRTH ok WITH DEAD;
    ATTEMPT {
        BIRTH actual WITH SCRY("work/" + name + ".actual");
        BIRTH expected WITH SCRY("cases/" + name + ".expected");
        ok = matches(actual, expected, mode);
    } SALVAGE err {
        ok = DEAD;
    }

    BIRTH nextPassed WITH passed;
    BIRTH nextFailed WITH failed;
    BIRTH nextFailures WITH failures;
    SHOULD ok {
        UTTER("  pass  " + name);
        nextPassed = passed + 1;
    } LEST {
        UTTER("  FAIL  " + name);
        nextFailed = failed + 1;
        nextFailures = APPEND(failures, name);
    }

    runCase(i + 1, nextPassed, nextFailed, skipped, nextFailures);
}

UTTER("running ", total, " cases (", target, ")...");
runCase(0, 0, 0, 0, []);

THIS.DIE();
