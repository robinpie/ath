RITE stmtAsync(node, branchNames, asyncRites) {
    BIRTH nt WITH node.t;
    SHOULD nt == "AthLoop" {
        BIRTH isA WITH entityIsAsync(node.entity, branchNames);
        BIRTH newBn WITH branchNames;
        SHOULD NOT isA AND node.entity.t == "EntityIdent" {
            newBn = SET(newBn, node.entity.name, ALIVE);
        }
        BIRTH bodyR WITH stmtsAsync(node.body, newBn, asyncRites);
        asyncRites = bodyR.asyncRites;
        BIRTH execR WITH stmtsAsync(node.exec, newBn, asyncRites);
        asyncRites = execR.asyncRites;
        BEQUEATH {async: isA, asyncRites: asyncRites};
    }
    SHOULD nt == "Bifurcate" {
        BIRTH newBn WITH SET(SET(branchNames, node.br1, ALIVE), node.br2, ALIVE);
        BEQUEATH {async: DEAD, asyncRites: asyncRites};
    }
    SHOULD nt == "RiteDef" {
        BIRTH bodyR WITH stmtsAsync(node.body, branchNames, asyncRites);
        asyncRites = bodyR.asyncRites;
        SHOULD bodyR.async {
            asyncRites = SET(asyncRites, node.name, ALIVE);
        }
        BEQUEATH {async: DEAD, asyncRites: asyncRites};
    }
    SHOULD nt == "Cond" {
        BIRTH thenR WITH stmtsAsync(node.then, branchNames, asyncRites);
        asyncRites = thenR.asyncRites;
        BIRTH elsAsync WITH DEAD;
        SHOULD TYPEOF(node.els) == "ARRAY" {
            BIRTH elsR WITH stmtsAsync(node.els, branchNames, asyncRites);
            asyncRites = elsR.asyncRites;
            elsAsync = elsR.async;
        }
        SHOULD TYPEOF(node.els) == "MAP" AND node.els.t == "Cond" {
            BIRTH elsR WITH stmtAsync(node.els, branchNames, asyncRites);
            asyncRites = elsR.asyncRites;
            elsAsync = elsR.async;
        }
        BEQUEATH {async: thenR.async OR elsAsync, asyncRites: asyncRites};
    }
    SHOULD nt == "AttemptSalvage" {
        BIRTH attR WITH stmtsAsync(node.attempt, branchNames, asyncRites);
        asyncRites = attR.asyncRites;
        BIRTH salR WITH stmtsAsync(node.salvage, branchNames, asyncRites);
        asyncRites = salR.asyncRites;
        BEQUEATH {async: attR.async OR salR.async, asyncRites: asyncRites};
    }
    BEQUEATH {async: DEAD, asyncRites: asyncRites};
}

