// cps.~ATH — CPS analysis pass
// analyze(ast, branchNames) -> {ast: annotatedAst, asyncRites: asyncRiteSet}
// Annotates each node with "async": ALIVE or DEAD.
// A node is async if it contains (directly or transitively) an AthLoop
// whose entity is not a known branch entity.

RITE entityIsAsync(entityNode, branchNames) {
    SHOULD entityNode.t == "EntityIdent" {
        SHOULD HAS(branchNames, entityNode.name) { BEQUEATH DEAD; }
        BEQUEATH ALIVE;
    }
    SHOULD entityNode.t == "EntityAnd" OR entityNode.t == "EntityOr" {
        BEQUEATH entityIsAsync(entityNode.left, branchNames) OR entityIsAsync(entityNode.right, branchNames);
    }
    SHOULD entityNode.t == "EntityNot" {
        BEQUEATH DEAD;
    }
    BEQUEATH DEAD;
}

